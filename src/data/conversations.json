              "hale",
              "Good morning, Class 1. I'm Mr Hale. First question of the year, and it's an easy one."
            ],
            [
              "hale",
              "How many days are there in a season?"
            ],
            [
              "you",
              "(You know this one. You start to put your hand up.)"
            ],
            [
              "juno",
              "Thirty! Thirty days in every season, and four seasons in a year."
            ],
            [
              "hale",
              "Very good, Juno. The first gold star of the year."
            ]
          ],
          "effects": {
            "setFlag": "first-lesson"
          },
          "choices": [
            {
              "text": "(Say nothing)",
              "effects": {
                "setFlag": "juno-friendly",
                "traits": {
                  "calm": 1
                }
              },
              "next": "quiet"
            },
            {
              "text": "I knew that too!",
              "effects": {
                "setFlag": "juno-bitter",
                "bondWith": {
                  "juno": -1
                },
                "traits": {
                  "bold": 1
                }
              },
              "next": "knew"
            },
            {
              "text": "(Whisper to Nico) \"Show-off.\"",
              "effects": {
                "setFlag": "juno-cruel",
                "bondWith": {
                  "juno": -2,
                  "nico": 1
                },
                "traits": {
                  "cheeky": 1
