              "effects": {
                "bond": 2,
                "happiness": 3
              },
              "next": "sing"
            },
            {
              "text": "I hope it's not a crybaby.",
              "effects": {
                "traits": {
                  "cheeky": 1
                }
              },
              "next": "cry"
            }
          ]
        },
        "okay": {
          "lines": [
